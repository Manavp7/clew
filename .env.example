# --- Database (Postgres = the only source of truth) ---
# Write-capable role used ONLY by extraction pipelines.
CLEW_DATABASE_URL=postgresql+psycopg://clew:clew@localhost:5432/clew
# Optional dedicated read-only role for the reasoning/API layer.
# If unset, the API falls back to CLEW_DATABASE_URL but opens read-only transactions.
CLEW_DATABASE_URL_RO=postgresql+psycopg://clew_ro:clew_ro@localhost:5432/clew

# --- LLM / Embeddings provider abstraction (Vercel AI Gateway) ---
# No provider is hardcoded; everything flows through src/clew/llm.
# Vercel AI Gateway is OpenAI-compatible.
CLEW_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
CLEW_LLM_API_KEY=
# Model ids are provider-prefixed and swappable without code changes.
CLEW_EXTRACTION_MODEL=openai/gpt-5
CLEW_REASONING_MODEL=openai/gpt-5
# Embeddings: "local" (Qwen3-Embedding via sentence-transformers, CPU) or a gateway model id.
CLEW_EMBEDDING_MODEL=local:Qwen/Qwen3-Embedding-0.6B
CLEW_EMBEDDING_DIM=1024

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent: "Name email".
CLEW_SEC_USER_AGENT=clew-research research@example.com

# --- Paths ---
CLEW_DATA_DIR=data
